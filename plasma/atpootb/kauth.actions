[Domain]
Name=AeroThemePlasma OOTB Experience
Icon=kauth-example
URL=https://gitgud.io/wackyideas/aerothemeplasma

[io.gitgud.wackyideas.ootb.apply]
Name=Apply Cursor Theme
Description=Set global default cursor theme required for SDDM
Policy=auth_admin

[io.gitgud.wackyideas.ootb.backup]
Name=Back up system settings before applying AeroThemePlasma
Description=Create a protected rollback snapshot of the system settings changed by AeroThemePlasma
Policy=auth_admin_keep

[io.gitgud.wackyideas.ootb.capture]
Name=Record AeroThemePlasma system settings
Description=Record the resulting system settings for safe rollback
Policy=auth_admin_keep
